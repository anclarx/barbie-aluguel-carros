# Copie para backend/.env (não versionado). O Spring lê esse arquivo sozinho ao subir (application.yml).

# Banco: Supabase > botão "Connect" > aba Direct > Type: JDBC > Method: Session pooler.
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.seu-projeto
DB_PASSWORD=sua-senha-do-banco

# Pelo menos 32 caracteres. Veja no README como gerar.
JWT_SECRET=

CORS_ORIGENS=http://localhost:5173
FRONT_URL=http://localhost:5173

# E-mail de "esqueci a senha" (opcional). Sem MAIL_HOST, o link só aparece no log do back-end.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=seu@gmail.com e, em MAIL_PASSWORD, uma
# "senha de app" (myaccount.google.com/apppasswords, com a verificação em duas etapas ligada), não a senha da conta.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Remetente que aparece no e-mail; se ficar vazio, usa MAIL_USERNAME.
MAIL_FROM=
